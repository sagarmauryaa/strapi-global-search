{
  "name": "strapi-global-search",
  "version": "1.0.0",
  "description": "Spotlight-style global search across every collection type and single type in the Strapi v4 admin panel. Zero configuration.",
  "keywords": [
    "strapi",
    "strapi-plugin",
    "search",
    "global-search",
    "spotlight",
    "command-palette",
    "admin"
  ],
  "strapi": {
    "name": "global-search",
    "kind": "plugin",
    "displayName": "Global Search",
    "description": "Search every content type from one place, with a Cmd+K palette.",
